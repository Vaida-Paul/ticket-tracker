# Copy this file to .env and adjust the values for your machine.
# The application imports .env automatically on startup.

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/your-db
DB_USERNAME=your-username
DB_PASSWORD=change-me

# --- JWT ---
# Use a long random string (at least 32 bytes). Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Mail (Mailpit runs on port 1025 in the local stack) ---
MAIL_HOST=localhost
MAIL_PORT=1025

# --- Digest job ---
DIGEST_CRON=0 0 8 * * *
DIGEST_FROM=noreply@ticket-tracker.local
